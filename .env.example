# Copy this file to .env for local development. Replace every placeholder.
NODE_ENV=development
# Local port matching the frontend's BACKEND_API_ORIGIN. Render supplies its own PORT.
PORT=4000
# Replace all Atlas placeholders with the credentials and cluster for your database.
MONGODB_URI="mongodb+srv://mmislam272_db_user:iKALQEDfDhHxEV2g@cluster0.3vtnoro.mongodb.net"
# Database name shared by Better Auth and application collections.
MONGODB_DB_NAME=doctor_tracker
# Replace with a generated random secret of at least 32 characters. Do not commit it.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# For local development, this is the frontend origin (no path or trailing slash).
BETTER_AUTH_URL=http://localhost:3000
# Must match BETTER_AUTH_URL exactly; set to the public site origin in production.
FRONTEND_ORIGIN=http://localhost:3000
